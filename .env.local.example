# =========================
# Catalogo / sitio publico
# Requeridas para esta etapa
# =========================

# URL publica del entorno. Se usa para SEO, sitemap y enlaces absolutos.
# Ejemplos: http://localhost:3000 o https://fira-estudio.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =========================
# Supabase catalogo
# Requeridas para renderizar productos reales
# =========================

# URL publica del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon key publica usada por App Router / SSR para consultas de catalogo
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# =========================
# Contacto
# Opcionales hasta definir canal principal
# =========================

# Email publico mostrado en UI o usado por mailto
NEXT_PUBLIC_CONTACT_EMAIL=contacto@example.com

# Numero de WhatsApp con codigo de pais, sin espacios ni +
NEXT_PUBLIC_WHATSAPP_NUMBER=549XXXXXXXXXX

# Perfil publico de Instagram
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/firaestudio

# =========================
# Analytics
# Opcional
# =========================

NEXT_PUBLIC_GA_MEASUREMENT_ID=

# =========================
# Maintenance mode del catalogo
# Opcional
# =========================

NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_MAINTENANCE_MESSAGE=Estamos actualizando el catalogo.

# =========================
# Infraestructura historica de comercio
# No requerida para catalogo
# =========================

# Service role para flujos server-side historicos de carrito/ordenes.
# No cargar por defecto en deploy catalogo.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago historico. No requerido para el setup normal.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_INTEGRATOR_ID=
MERCADOPAGO_WEBHOOK_URL=

# Webhooks historicos. No requeridos para el catalogo.
WEBHOOK_RECONCILIATION_TOKEN=
WEBHOOK_QUEUE_PROCESSOR_TOKEN=
WEBHOOK_STATUS_TOKEN=
CRON_SECRET=

# Debug de webhooks historicos.
# Nunca habilitar en production.
# WEBHOOK_SKIP_IP_VALIDATION=true
# WEBHOOK_SKIP_SIGNATURE_VALIDATION=true

# Emails transaccionales historicos. No requeridos para el catalogo.
RESEND_API_KEY=
# RESEND_FROM_EMAIL=Fira Estudio <noreply@example.com>

# Revalidacion manual. No requerida para catalogo basico.
REVALIDATE_SECRET=
